# SWMS env example — copy to .env
DATABASE_URL="postgresql://swms:swms_dev_password@localhost:5432/swms?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Storage: local | s3 | cloudinary (MVP uses local)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="8"
# Optional future AI classification (leave empty for MVP manual mode)
AI_CLASSIFY_API_URL=""
AI_CLASSIFY_API_KEY=""
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_DEFAULT_LAT="-17.824858"
NEXT_PUBLIC_MAP_DEFAULT_LNG="31.053028"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM="13"
